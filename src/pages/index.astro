---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import ContactCta from "@/components/ContactCta.astro";
import { getAllPosts } from "@/lib/posts";
import { SITE_NAME, SITE_TAGLINE, SITE_DESCRIPTION } from "@/consts";
import { buildOrganizationSchema } from "@/lib/schema";

const latestPosts = getAllPosts().slice(0, 3);
const organizationSchema = buildOrganizationSchema();
---

<BaseLayout title={SITE_NAME} description={SITE_DESCRIPTION} ogImage="/open-graph/default.png" pagefindIgnore jsonLd={organizationSchema}>
  <section class="mx-auto max-w-6xl px-5 pb-20 pt-16 md:pt-24">
    <div class="max-w-2xl">
      <h1 class="mt-4 text-4xl font-extrabold leading-tight tracking-tight text-ink-950 md:text-5xl">
        {SITE_TAGLINE}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-neutral-500">{SITE_DESCRIPTION}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/blog" class="rounded-full bg-brand-600 px-6 py-3 text-sm font-bold text-white hover:bg-brand-700">
          最新記事を読む
        </a>
        <a href="/contact" class="rounded-full border border-neutral-200 px-6 py-3 text-sm font-bold text-ink-950 hover:border-brand-300">
          お問い合わせ
        </a>
      </div>
    </div>
  </section>

  {
    latestPosts.length > 0 && (
      <section class="border-t border-neutral-100 bg-neutral-50 py-16">
        <div class="mx-auto max-w-6xl px-5">
          <div class="flex items-end justify-between">
            <h2 class="text-2xl font-bold tracking-tight text-ink-950">最新記事</h2>
            <a href="/blog" class="text-sm font-medium text-brand-700 hover:underline">
              記事一覧へ →
            </a>
          </div>
          <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {latestPosts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <ContactCta />
</BaseLayout>
