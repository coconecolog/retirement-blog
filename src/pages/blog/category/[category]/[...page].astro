---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostCard from '../../../../components/PostCard.astro';
import Pagination from '../../../../components/Pagination.astro';
import BlogSidebar from '../../../../components/BlogSidebar.astro';
import { getAllPosts, getAllCategories, getAllTags, getCategoryMeta } from '../../../../lib/notion';
import { SITE } from '../../../../lib/site.config';

export async function getStaticPaths({ paginate }: any) {
  const posts = await getAllPosts();
  const categories = await getAllCategories();

  return categories.flatMap((category) => {
    const filtered = posts.filter((p) => p.categories.includes(category));
    return paginate(filtered, {
      params: { category },
      pageSize: SITE.postsPerPage,
    });
  });
}

const { page } = Astro.props as any;
const { category } = Astro.params;
const categories = await getAllCategories();
const tags = await getAllTags();
const popularPosts = (await getAllPosts()).slice(0, 5);
const categoryMeta = await getCategoryMeta();
const meta = category ? categoryMeta.get(category) : undefined;
---

<BaseLayout
  title={`「${category}」の記事一覧`}
  description={meta?.description || `${SITE.title}の「${category}」カテゴリの記事一覧`}
  canonicalPath={page.currentPage === 1 ? `/blog/category/${category}` : `/blog/category/${category}/${page.currentPage}`}
>
  <div class="mx-auto max-w-6xl px-6 py-16">
    <nav class="mb-6 text-sm text-[var(--color-ink-muted)]">
      <a href="/" class="hover:text-[var(--color-brand)]">トップ</a>
      <span class="mx-2">/</span>
      <a href="/blog" class="hover:text-[var(--color-brand)]">ブログ一覧</a>
      <span class="mx-2">/</span>
      <span>{category}</span>
    </nav>

    <div class="mb-10">
      <h1 class="text-3xl font-bold text-[var(--color-ink)]">「{category}」の記事</h1>
      {meta?.description && (
        <p class="mt-4 max-w-2xl whitespace-pre-line text-[var(--color-ink-muted)]">{meta.description}</p>
      )}
    </div>

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_280px]">
      <div class="min-w-0">
        {categories.length > 0 && (
          <div class="mb-10 flex flex-wrap gap-2">
            {categories.map((c) => (
              <a href={`/blog/category/${encodeURIComponent(c)}`} class={`rounded-full border px-4 py-1.5 text-sm font-medium transition-colors ${
                  c === category
                    ? 'border-[var(--color-brand)] bg-[var(--color-brand)] text-white'
                    : 'border-[var(--color-border)] text-[var(--color-ink-muted)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand)]'
                }`}>
                {c}
              </a>
            ))}
          </div>
        )}

        {page.data.length > 0 ? (
          <div class="grid gap-6 sm:grid-cols-2">
            {page.data.map((post: any) => <PostCard post={post} />)}
          </div>
        ) : (
          <p class="rounded-2xl border border-dashed border-[var(--color-border)] p-10 text-center text-[var(--color-ink-muted)]">
            該当する記事がありません。
          </p>
        )}

        <Pagination currentPage={page.currentPage} lastPage={page.lastPage} basePath={`/blog/category/${category}`} />

        {meta?.content && (
          <div class="prose prose-neutral mt-12 max-w-none" set:html={meta.content} />
        )}
      </div>

      <BlogSidebar categories={categories} popularPosts={popularPosts} tags={tags} />
    </div>
  </div>
</BaseLayout>
