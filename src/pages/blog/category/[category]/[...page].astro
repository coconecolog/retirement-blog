---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostCard from '../../../../components/PostCard.astro';
import Pagination from '../../../../components/Pagination.astro';
import NoteBox from '../../../../components/NoteBox.astro';
import { getAllPosts, getAllCategories, getCategoryMeta } from '../../../../lib/notion';
import { formatDateDot, estimateReadMinutes } from '../../../../lib/format';
import { SITE, THEMES, findTheme, themeHref, themeColor } from '../../../../lib/site.config';

export async function getStaticPaths({ paginate }: any) {
  const posts = await getAllPosts();
  // 記事が0件のテーマも、ページだけは作っておく（ヘッダー・フッターからリンクしているため）
  const categories = [...new Set([...THEMES.map((t) => t.name), ...(await getAllCategories())])];

  return categories.flatMap((category) => {
    const filtered = posts.filter((p) => p.categories.includes(category));
    return paginate(filtered, {
      params: { category },
      pageSize: SITE.postsPerPage,
    });
  });
}

const { page } = Astro.props as any;
const { category } = Astro.params as { category: string };
const allPosts = await getAllPosts();
const categoryMeta = await getCategoryMeta();
const meta = categoryMeta.get(category);
const theme = findTheme(category);
const otherThemes = THEMES.filter((t) => t.name !== category).slice(0, 2);
const isFirstPage = page.currentPage === 1;

// 「最初に読むなら」：マスターカテゴリDBの「代表記事」。未設定ならこのテーマの最初の記事（いちばん古い記事）。
const themePosts = allPosts.filter((p) => p.categories.includes(category));
const startHere =
  (meta?.representativePageId && allPosts.find((p) => p.id === meta.representativePageId)) ||
  themePosts[themePosts.length - 1];

const basePath = `/blog/category/${category}`;
const shownFrom = (page.currentPage - 1) * SITE.postsPerPage + 1;
const shownTo = shownFrom + page.data.length - 1;
---

<BaseLayout
  title={category}
  description={meta?.description || theme?.intro || `${SITE.title}の「${category}」の記事一覧`}
  canonicalPath={isFirstPage ? basePath : `${basePath}/${page.currentPage}`}
>
  <!-- ===== テーマの紹介 ===== -->
  <section class="px-6 pt-[30px] pb-12 md:px-24">
    <div class="mx-auto max-w-[1248px]">
      <nav class="flex flex-wrap items-center gap-[14px] text-[11px] text-[var(--color-ink-muted)]" aria-label="パンくずリスト">
        <a href="/" class="hover:text-[var(--color-brand)]">ホーム</a>
        <span>／</span>
        <a href="/#themes" class="hover:text-[var(--color-brand)]">3つのテーマ</a>
        <span>／</span>
        <span>{category}</span>
      </nav>

      <div class="mt-10 flex flex-col gap-10 lg:mt-12 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-[784px]">
          <p class="eyebrow whitespace-pre">{theme ? `THEME ${theme.number}  /  ${theme.en}` : 'THEME'}</p>
          <h1 class="mt-6 font-serif text-[36px] font-semibold leading-[1.5] text-[var(--color-ink)] sm:text-[46px]">{category}</h1>
          <div class="mt-6 text-[15px] leading-[2] text-[var(--color-ink-muted)]">
            {theme?.tagline && <p>{theme.tagline}</p>}
            <p>{theme?.intro || meta?.description}</p>
          </div>
        </div>
        {theme && (
          <div class="flex shrink-0 flex-col items-center gap-2 self-center">
            <img src={`/images/themes/intro-${theme.key}.svg`} alt="" width="400" height="275" class="h-auto w-full max-w-[400px]" />
            <p class="text-[12px] text-[var(--color-brand)]">{theme.caption}</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ===== 最初に読むなら ===== -->
  {isFirstPage && startHere && (
    <section class="bg-[var(--color-sand)] px-6 py-10 md:px-24">
      <div class="mx-auto max-w-[1248px]">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
          <p class="eyebrow whitespace-pre">START HERE  /  最初に読むなら</p>
          {theme?.startHereNote && <p class="text-[12px] text-[var(--color-ink-muted)]">{theme.startHereNote}</p>}
        </div>
        <a href={`/blog/${startHere.slug}`} class="group mt-6 flex flex-col gap-8 rounded-[24px] bg-[var(--color-surface)] p-6 md:flex-row md:items-center md:gap-10">
          <div class="aspect-[16/9] w-full shrink-0 overflow-hidden rounded-[16px] md:w-[384px]" style={`background-color: ${themeColor(category)}`}>
            {startHere.thumbnail && <img src={startHere.thumbnail} alt="" class="h-full w-full object-cover" />}
          </div>
          <div class="min-w-0 flex-1 md:pr-4">
            <p class="font-serif text-[24px] font-semibold leading-[1.6] text-[var(--color-ink)] sm:text-[30px]">{startHere.title}</p>
            <p class="mt-4 line-clamp-2 text-[14px] leading-[1.9] text-[var(--color-ink-muted)]">{startHere.description}</p>
            <div class="mt-5 flex items-center justify-between">
              <span class="text-[11px] text-[var(--color-ink-muted)]">{formatDateDot(startHere.publishedAt)} · 約{estimateReadMinutes(startHere.html)}分</span>
              <span class="text-[13px] font-medium text-[var(--color-brand)] group-hover:underline">このログを読む →</span>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- ===== この道の、実験ログ ===== -->
  <section class="px-6 py-16 md:px-24">
    <div class="mx-auto max-w-[1248px]">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">LATEST LOGS</p>
          <h2 class="mt-4 font-serif text-[28px] font-semibold text-[var(--color-ink)] sm:text-[34px]">この道の、実験ログ</h2>
          <p class="mt-3 text-[14px] text-[var(--color-ink-muted)]">うまくいったことも、まだ迷っていることも。新しい記録から並べています。</p>
        </div>
        <p class="text-[12px] text-[var(--color-ink-muted)]">全{page.total}件 / 新しい順</p>
      </div>

      {page.data.length > 0 ? (
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {page.data.map((post: any) => <PostCard post={post} />)}
        </div>
      ) : (
        <p class="mt-10 rounded-[20px] border border-dashed border-[var(--color-border)] p-10 text-center text-[14px] text-[var(--color-ink-muted)]">
          このテーマの記録は、これから増えていきます。
        </p>
      )}

      {page.data.length > 0 && (
        <p class="mt-8 text-center text-[12px] text-[var(--color-ink-muted)]">
          {page.lastPage > 1 ? `全${page.total}件のうち ${shownFrom}〜${shownTo}件目を表示しています` : `${page.total}件の記録を表示しています`}
        </p>
      )}
      <Pagination currentPage={page.currentPage} lastPage={page.lastPage} basePath={basePath} />
    </div>
  </section>

  <!-- ===== 今回の気づき（Notionのマスターカテゴリのページ本文） ===== -->
  {isFirstPage && meta?.content && <NoteBox title="今回の気づき" html={meta.content} />}

  <!-- ===== となりの道も、歩いてみる ===== -->
  <section class="bg-[var(--color-sand)] px-6 py-14 md:px-24">
    <div class="mx-auto max-w-[1248px]">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">ALONG THE SAME PATH</p>
          <h2 class="mt-4 font-serif text-[26px] font-semibold text-[var(--color-ink)] sm:text-[30px]">となりの道も、歩いてみる</h2>
        </div>
        <p class="text-[13px] text-[var(--color-ink-muted)]">どの入口からも、同じ暮らしへ。</p>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {otherThemes.map((t) => (
          <a href={themeHref(t.name)} class="group flex items-center gap-6 rounded-[24px] bg-[var(--color-surface)] p-6">
            <img src={`/images/themes/circle-${t.key}.svg`} alt="" width="150" height="150" class="size-[110px] shrink-0 sm:size-[150px]" />
            <div class="min-w-0">
              <p class="font-serif text-[20px] font-semibold text-[var(--color-ink)] sm:text-[24px]">{t.name}</p>
              <p class="mt-3 text-[13px] leading-[1.9] text-[var(--color-ink-muted)]">{t.blurb}</p>
              <p class="mt-3 text-[12px] text-[var(--color-brand)] group-hover:underline">このテーマを読む →</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
