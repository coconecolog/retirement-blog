---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts } from '../../lib/notion';
import { formatDateDot, estimateReadMinutes } from '../../lib/format';
import { SITE, ARTICLE_SIGNATURE, ARTICLE_DISCLAIMER, AUTHOR_PROFILE, themeColor } from '../../lib/site.config';

export async function getStaticPaths() {
  const posts = await getAllPosts();

  return posts.map((post) => {
    // 「この話のとなりに」に並べる2記事。
    // 1) 同じメインタグの記事 → 2) 同じカテゴリの記事 → 3) 新しい記事 の順で、自分を除いて2件になるまで埋める。
    const others = posts.filter((p) => p.id !== post.id);
    const sameMainTag = post.mainTag ? others.filter((p) => p.mainTag === post.mainTag) : [];
    const primaryCategory = post.categories?.[0] ?? null;
    const sameCategory = primaryCategory ? others.filter((p) => p.categories.includes(primaryCategory)) : [];
    const neighbors = [...new Set([...sameMainTag, ...sameCategory, ...others])].slice(0, 2);

    return {
      params: { slug: post.slug },
      props: { post, neighbors, primaryCategory },
    };
  });
}

const { post, neighbors, primaryCategory } = Astro.props as any;

// 黄色のコールアウト（今回わかったこと）が複数ある場合、目次からのジャンプ先は最初の1つだけにする。
let findingsSeen = false;
const html: string = post.html.replace(/ id="findings"/g, (m: string) => {
  if (findingsSeen) return '';
  findingsSeen = true;
  return m;
});
const hasFindings = findingsSeen;

const readMinutes = estimateReadMinutes(post.html);
const authorName: string = post.author?.name ?? AUTHOR_PROFILE.label;
const categoryHref = primaryCategory ? `/blog/category/${encodeURIComponent(primaryCategory)}` : null;
const toc: { id: string; text: string }[] = post.toc ?? [];

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.description,
  datePublished: post.publishedAt,
  dateModified: post.updatedAt,
  image: post.thumbnail ? [new URL(post.thumbnail, SITE.url).toString()] : undefined,
  author: { '@type': 'Organization', name: SITE.title },
  publisher: { '@type': 'Organization', name: SITE.title },
  mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(`/blog/${post.slug}`, SITE.url).toString() },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: '実験ログ', item: new URL('/blog', SITE.url).toString() },
    ...(primaryCategory
      ? [{ '@type': 'ListItem', position: 3, name: primaryCategory, item: new URL(categoryHref as string, SITE.url).toString() }]
      : []),
    { '@type': 'ListItem', position: primaryCategory ? 4 : 3, name: post.title, item: new URL(`/blog/${post.slug}`, SITE.url).toString() },
  ],
};
---

<BaseLayout
  title={post.title}
  description={post.description}
  type="article"
  canonicalPath={`/blog/${post.slug}`}
  ogImage={`/og/${post.slug}.png`}
  jsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  <!-- ===== 記事の冒頭 ===== -->
  <section class="px-6 pt-[30px] pb-12 md:px-24 md:pb-16">
    <div class="mx-auto max-w-[1248px]">
      <nav class="flex flex-wrap items-center gap-[14px] text-[11px] text-[var(--color-ink-muted)]" aria-label="パンくずリスト">
        <a href="/" class="hover:text-[var(--color-brand)]">ホーム</a>
        <span>／</span>
        <a href="/blog" class="hover:text-[var(--color-brand)]">実験ログ</a>
        {primaryCategory && (
          <>
            <span>／</span>
            <a href={categoryHref} class="hover:text-[var(--color-brand)]">{primaryCategory}</a>
          </>
        )}
      </nav>

      <div class="mt-12 flex flex-col items-center gap-6 text-center md:mt-14">
        <p class="eyebrow whitespace-pre">{primaryCategory ? `${primaryCategory}  /  実験ログ` : '実験ログ'}</p>
        <h1 class="max-w-[980px] font-serif text-[30px] font-semibold leading-[1.55] text-[var(--color-ink)] sm:text-[38px] lg:text-[46px]">{post.title}</h1>
        {post.summary && (
          <p class="max-w-[760px] whitespace-pre-line text-[15px] leading-[2] text-[var(--color-ink-muted)] sm:text-[17px]">{post.summary}</p>
        )}
        <div class="flex flex-wrap items-center justify-center gap-4 text-[12px] text-[var(--color-ink-muted)]">
          <span class="text-[var(--color-ink)]">{authorName}</span>
          <span class="size-[3px] rounded-full bg-[var(--color-accent)]"></span>
          <time datetime={post.publishedAt}>{formatDateDot(post.publishedAt)}</time>
          <span class="size-[3px] rounded-full bg-[var(--color-accent)]"></span>
          <span>約{readMinutes}分で読めます</span>
        </div>
      </div>

      {post.thumbnail && (
        <div class="mx-auto mt-12 max-w-[760px] md:mt-14">
          <img src={post.thumbnail} alt="" class="aspect-[16/9] w-full object-cover" />
        </div>
      )}
    </div>
  </section>

  <!-- ===== 本文エリア（左：目次／右：本文） ===== -->
  <section class="px-6 md:px-24">
    <div class="mx-auto flex max-w-[1248px] flex-col gap-10 lg:flex-row lg:gap-[54px]">
      {toc.length > 0 && (
        <aside class="lg:w-[190px] lg:shrink-0">
          <div class="flex flex-col gap-6 pt-1 lg:sticky lg:top-8">
            <p class="eyebrow">このログの道順</p>
            <ol class="flex flex-col gap-6">
              {toc.map((item, i) => (
                <li>
                  <a href={`#${item.id}`} class="group flex items-start gap-3">
                    <span class="pt-[5px] text-[11px] leading-none text-[var(--color-accent)]">{String(i + 1).padStart(2, '0')}</span>
                    <span class="text-[12px] leading-[1.9] text-[var(--color-ink-muted)] group-hover:text-[var(--color-brand)]">{item.text}</span>
                  </a>
                </li>
              ))}
            </ol>
            <div class="h-px w-full bg-[var(--color-border)]"></div>
            {hasFindings && (
              <a href="#findings" class="text-[12px] leading-[1.9] text-[var(--color-brand)] hover:underline">今回わかったこと<br />次に試すこと</a>
            )}
            <p class="hidden whitespace-pre-line font-serif text-[13px] leading-[2] text-[var(--color-ink-muted)] lg:block">{ARTICLE_SIGNATURE.replace('。', '。\n')}</p>
          </div>
        </aside>
      )}

      <div class="min-w-0 max-w-[760px] flex-1">
        <article class="prose max-w-none [&_h2]:scroll-mt-8 [&_h3]:scroll-mt-8 [&>*:first-child]:mt-0" set:html={html} />

        <!-- 締めの一言と注意書き -->
        <div class="mt-12 flex flex-col gap-6">
          <p class="text-right font-serif text-[14px] text-[var(--color-brand)]">{ARTICLE_SIGNATURE}</p>
          <p class="text-[11px] leading-[1.9] text-[var(--color-ink-muted)]">{ARTICLE_DISCLAIMER}</p>
        </div>

        <div class="mt-12 h-px w-full bg-[var(--color-border)]"></div>

        <!-- 記録する人 -->
        <div class="mt-12 flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-[30px]">
          <img src="/images/author-portrait.svg" alt="" width="150" height="154" class="h-[154px] w-[150px] shrink-0" />
          <div class="flex flex-col gap-3">
            <p class="eyebrow">{AUTHOR_PROFILE.label}</p>
            <p class="whitespace-pre-line font-serif text-[20px] font-semibold leading-[1.6] text-[var(--color-ink)]">{AUTHOR_PROFILE.headline}</p>
            <p class="text-[13px] leading-[2] text-[var(--color-ink-muted)]">{AUTHOR_PROFILE.bio}</p>
            <a href="/about" class="text-[12px] text-[var(--color-brand)] hover:underline">このサイトについて →</a>
          </div>
        </div>

        <!-- 一覧・テーマへの戻りリンク -->
        <div class="mt-12 flex flex-col gap-3 pt-4 pb-[88px] text-[13px] text-[var(--color-brand)] sm:flex-row sm:justify-between">
          <a href="/blog" class="hover:underline">← 実験ログの一覧へ</a>
          {primaryCategory && <a href={categoryHref} class="hover:underline">「{primaryCategory}」を読む →</a>}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== この話のとなりに ===== -->
  {neighbors.length > 0 && (
    <section class="bg-[var(--color-sand)] px-6 py-[72px] md:px-24">
      <div class="mx-auto max-w-[1000px]">
        <div class="flex flex-col gap-4">
          <p class="eyebrow">ALONG THE SAME PATH</p>
          <h2 class="font-serif text-[26px] font-semibold text-[var(--color-ink)] sm:text-[32px]">この話のとなりに</h2>
          <p class="text-[14px] text-[var(--color-ink-muted)]">お金、時間、小さな挑戦。どの入口からも、同じ暮らしへ。</p>
        </div>

        <div class="mt-9 grid gap-10 sm:grid-cols-2">
          {neighbors.map((item: any) => {
            const category = item.categories?.[0] ?? null;
            return (
              <a href={`/blog/${item.slug}`} class="group flex flex-col gap-[18px]">
                <div class="aspect-[16/9] w-full overflow-hidden" style={`background-color: ${themeColor(category)}`}>
                  {item.thumbnail && (
                    <img src={item.thumbnail} alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" />
                  )}
                </div>
                {category && <p class="text-[11px] font-bold text-[var(--color-brand)]">{category}</p>}
                <p class="font-serif text-[20px] font-semibold leading-[1.6] text-[var(--color-ink)] sm:text-[24px]">{item.title}</p>
                <p class="line-clamp-2 text-[13px] leading-[1.9] text-[var(--color-ink-muted)]">{item.description}</p>
                <div class="flex items-center justify-between">
                  <span class="text-[11px] text-[var(--color-ink-muted)]">{formatDateDot(item.publishedAt)}</span>
                  <span class="text-[12px] text-[var(--color-brand)] group-hover:underline">続きを読む →</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
