---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import TagFilter from '../../components/TagFilter.astro';
import Pagination from '../../components/Pagination.astro';
import { getAllPosts, getAllTags } from '../../lib/notion';
import { SITE } from '../../lib/site.config';

export async function getStaticPaths({ paginate }: any) {
  const posts = await getAllPosts();
  return paginate(posts, { pageSize: SITE.postsPerPage });
}

const { page } = Astro.props as any;
const tags = await getAllTags();
---

<BaseLayout
  title="ブログ"
  description={`${SITE.title}のブログ記事一覧`}
  canonicalPath={page.currentPage === 1 ? '/blog' : `/blog/${page.currentPage}`}
>
  <div class="mx-auto max-w-5xl px-6 py-16">
    <div class="mb-10">
      <h1 class="text-3xl font-bold text-[var(--color-ink)]">ブログ</h1>
      <p class="mt-3 max-w-2xl text-[var(--color-ink-muted)]">
        資産形成の基礎から、老後に向けた出口戦略まで。実践に役立つ考え方をお届けします。
      </p>
    </div>

    <div class="mb-10">
      <TagFilter tags={tags} />
    </div>

    {page.data.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {page.data.map((post: any) => <PostCard post={post} />)}
      </div>
    ) : (
      <p class="rounded-2xl border border-dashed border-[var(--color-border)] p-10 text-center text-[var(--color-ink-muted)]">
        まだ公開されている記事がありません。Notionで記事を作成し「公開」フラグをオンにすると、ここに表示されます。
      </p>
    )}

    <Pagination currentPage={page.currentPage} lastPage={page.lastPage} basePath="/blog" />
  </div>
</BaseLayout>
