---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostCard from '../../../../components/PostCard.astro';
import Pagination from '../../../../components/Pagination.astro';
import BlogSidebar from '../../../../components/BlogSidebar.astro';
import AuthorBox from '../../../../components/AuthorBox.astro';
import { getAllPosts, getAllCategories, getAllTags, getAllAuthors, getAuthorBySlug } from '../../../../lib/notion';
import { SITE } from '../../../../lib/site.config';

export async function getStaticPaths({ paginate }: any) {
  const posts = await getAllPosts();
  const authors = await getAllAuthors();

  return authors.flatMap((author) => {
    const filtered = posts.filter((p) => p.author?.slug === author.slug);
    return paginate(filtered, {
      params: { slug: author.slug },
      pageSize: SITE.postsPerPage,
    });
  });
}

const { page } = Astro.props as any;
const { slug } = Astro.params;
const author = slug ? await getAuthorBySlug(slug) : null;
const categories = await getAllCategories();
const tags = await getAllTags();
const popularPosts = (await getAllPosts()).slice(0, 5);
---

<BaseLayout
  title={author ? `${author.name}の記事一覧` : '執筆者の記事一覧'}
  description={author?.bio || `${SITE.title}の執筆者の記事一覧`}
  canonicalPath={page.currentPage === 1 ? `/blog/author/${slug}` : `/blog/author/${slug}/${page.currentPage}`}
>
  <div class="mx-auto max-w-6xl px-6 py-16">
    <nav class="mb-6 text-sm text-[var(--color-ink-muted)]">
      <a href="/" class="hover:text-[var(--color-brand)]">トップ</a>
      <span class="mx-2">/</span>
      <a href="/blog" class="hover:text-[var(--color-brand)]">ブログ一覧</a>
      <span class="mx-2">/</span>
      <span>{author?.name ?? '執筆者'}</span>
    </nav>

    {author && (
      <div class="mb-12">
        <AuthorBox author={author} />
      </div>
    )}

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_280px]">
      <div class="min-w-0">
        <h1 class="mb-6 text-2xl font-bold text-[var(--color-ink)]">
          {author ? `${author.name}の記事一覧` : '記事一覧'}
        </h1>

        {page.data.length > 0 ? (
          <div class="grid gap-6 sm:grid-cols-2">
            {page.data.map((post: any) => <PostCard post={post} />)}
          </div>
        ) : (
          <p class="rounded-2xl border border-dashed border-[var(--color-border)] p-10 text-center text-[var(--color-ink-muted)]">
            該当する記事がありません。
          </p>
        )}

        <Pagination currentPage={page.currentPage} lastPage={page.lastPage} basePath={`/blog/author/${slug}`} />
      </div>

      <BlogSidebar categories={categories} popularPosts={popularPosts} tags={tags} />
    </div>
  </div>
</BaseLayout>
