---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostCard from '../../../../components/PostCard.astro';
import Pagination from '../../../../components/Pagination.astro';
import { getAllPosts, getAllAuthors, getAuthorBySlug } from '../../../../lib/notion';
import { SITE } from '../../../../lib/site.config';

export async function getStaticPaths({ paginate }: any) {
  const posts = await getAllPosts();
  const authors = await getAllAuthors();

  return authors.flatMap((author) => {
    const filtered = posts.filter((p) => p.author?.slug === author.slug);
    return paginate(filtered, {
      params: { slug: author.slug },
      pageSize: SITE.postsPerPage,
    });
  });
}

const { page } = Astro.props as any;
const { slug } = Astro.params;
const author = slug ? await getAuthorBySlug(slug) : null;
const name = author?.name ?? '執筆者';
const basePath = `/blog/author/${slug}`;
---

<BaseLayout
  title={`${name}の記事一覧`}
  description={author?.bio || `${SITE.title}の${name}の記事一覧`}
  canonicalPath={page.currentPage === 1 ? basePath : `${basePath}/${page.currentPage}`}
>
  <section class="px-6 pt-[30px] pb-20 md:px-24">
    <div class="mx-auto max-w-[1248px]">
      <nav class="flex items-center gap-[14px] text-[11px] text-[var(--color-ink-muted)]" aria-label="パンくずリスト">
        <a href="/" class="hover:text-[var(--color-brand)]">ホーム</a>
        <span>／</span>
        <a href="/blog" class="hover:text-[var(--color-brand)]">ブログ</a>
        <span>／</span>
        <span>{name}</span>
      </nav>
      <p class="eyebrow mt-10">WRITER</p>
      <h1 class="mt-4 font-serif text-[32px] font-semibold text-[var(--color-ink)] sm:text-[40px]">{name}</h1>
      {author?.bio && <p class="mt-5 max-w-[760px] whitespace-pre-line text-[15px] leading-[2] text-[var(--color-ink-muted)]">{author.bio}</p>}

      {page.data.length > 0 ? (
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {page.data.map((post: any) => <PostCard post={post} />)}
        </div>
      ) : (
        <p class="mt-12 rounded-[20px] border border-dashed border-[var(--color-border)] p-10 text-center text-[14px] text-[var(--color-ink-muted)]">記録は、これから増えていきます。</p>
      )}
      <Pagination currentPage={page.currentPage} lastPage={page.lastPage} basePath={basePath} />
    </div>
  </section>
</BaseLayout>
