---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import TagFilter from "@/components/TagFilter.astro";
import PostCard from "@/components/PostCard.astro";
import Pagination from "@/components/Pagination.astro";
import BlogSidebar from "@/components/BlogSidebar.astro";
import { getAllCategories, getAllPosts, getAllTags, getPopularPosts } from "@/lib/posts";
import { POSTS_PER_PAGE } from "@/consts";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = getAllPosts();
  return paginate(posts, { pageSize: POSTS_PER_PAGE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const tags = getAllTags();
const categories = getAllCategories();
const sidebarPopularPosts = getPopularPosts(5).map((p) => ({ slug: p.slug, title: p.title }));

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "ブログ", href: "/blog" },
];
---

<BaseLayout
  title="ブログ"
  description="マーケティング分析・施策・マーケット情報についての記事一覧です。"
  ogImage="/open-graph/default.png"
>
  <Breadcrumb items={breadcrumbItems} />

  <div class="mx-auto max-w-6xl px-5 py-12">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_320px]">
      <div class="min-w-0">
        <h1 class="text-3xl font-extrabold tracking-tight text-ink-950">ブログ</h1>
        <p class="mt-3 text-neutral-500">マーケティング分析・施策・マーケット情報をお届けします。</p>

        {tags.length > 0 && <div class="mt-6"><TagFilter tags={tags} /></div>}

        {
          page.data.length > 0 ? (
            <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {page.data.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          ) : (
            <p class="mt-10 text-neutral-400">まだ記事がありません。</p>
          )
        }

        <Pagination page={page} basePath="/blog" />
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <BlogSidebar categories={categories} popularPosts={sidebarPopularPosts} tags={tags} />
      </aside>
    </div>
  </div>
</BaseLayout>
