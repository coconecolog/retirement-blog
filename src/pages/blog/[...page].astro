---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import TagFilter from '../../components/TagFilter.astro';
import Pagination from '../../components/Pagination.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import { getAllPosts, getAllTags, getAllCategories } from '../../lib/notion';
import { SITE } from '../../lib/site.config';

export async function getStaticPaths({ paginate }: any) {
  const posts = await getAllPosts();
  return paginate(posts, { pageSize: SITE.postsPerPage });
}

const { page } = Astro.props as any;
const tags = await getAllTags();
const categories = await getAllCategories();
const popularPosts = (await getAllPosts()).slice(0, 5);
---

<BaseLayout
  title="ブログ一覧"
  description={SITE.description}
  canonicalPath={page.currentPage === 1 ? '/blog' : `/blog/${page.currentPage}`}
>
  <div class="mx-auto max-w-6xl px-6 py-16">
    <nav class="mb-6 text-sm text-[var(--color-ink-muted)]">
      <a href="/" class="hover:text-[var(--color-brand)]">トップ</a>
      <span class="mx-2">/</span>
      <span>ブログ一覧</span>
    </nav>

    <div class="mb-10">
      <h1 class="text-3xl font-bold text-[var(--color-ink)]">ブログ一覧</h1>
    </div>

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_280px]">
      <div class="min-w-0">
        <div class="mb-10">
          <TagFilter tags={tags} />
        </div>

        {page.data.length > 0 ? (
          <div class="grid gap-6 sm:grid-cols-2">
            {page.data.map((post: any) => <PostCard post={post} />)}
          </div>
        ) : (
          <p class="rounded-2xl border border-dashed border-[var(--color-border)] p-10 text-center text-[var(--color-ink-muted)]">
            記事がまだありません。
          </p>
        )}

        <Pagination currentPage={page.currentPage} lastPage={page.lastPage} basePath="/blog" />
      </div>

      <BlogSidebar categories={categories} popularPosts={popularPosts} tags={tags} />
    </div>
  </div>
</BaseLayout>
