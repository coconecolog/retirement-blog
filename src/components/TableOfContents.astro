---
import type { TocItem } from "@/lib/types";

interface Props {
  items: TocItem[];
  showHeading?: boolean;
  wrapped?: boolean;
}

const { items, showHeading = true, wrapped = true } = Astro.props;
---

{
  items.length > 0 && (
    <nav aria-label="目次" class={wrapped ? "rounded-2xl border border-neutral-100 bg-neutral-50 p-5" : ""}>
      {showHeading && <p class="mb-3 text-sm font-bold text-ink-950">目次</p>}
      <ul class="space-y-2 text-sm">
        {items.map((h2) => (
          <li>
            <a href={`#${h2.anchor}`} class="text-neutral-600 hover:text-brand-700">
              {h2.text}
            </a>
            {h2.children.length > 0 && (
              <ul class="mt-2 space-y-2 border-l border-neutral-200 pl-3">
                {h2.children.map((h3) => (
                  <li>
                    <a href={`#${h3.anchor}`} class="text-neutral-500 hover:text-brand-700">
                      {h3.text}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  )
}
