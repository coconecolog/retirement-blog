---
import { SITE } from '../lib/site.config';
---

<header class="sticky top-4 z-50 mt-4 px-6">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 rounded-2xl border border-black/5 bg-white/40 px-6 py-3 shadow-[0_8px_30px_-12px_rgba(0,0,0,0.15)] backdrop-blur-xl">
    <a href="/" class="shrink-0 text-base font-bold tracking-tight text-[var(--color-ink)]">
      {SITE.title}
    </a>
    
      <a href="/blog"
      class="shrink-0 rounded-full bg-[var(--color-ink)] px-5 py-2 text-sm font-semibold text-white transition-opacity hover:opacity-90"
    >
      記事を読む
    </a>
  </div>
</header>
