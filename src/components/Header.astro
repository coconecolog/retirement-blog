---
import { SITE, NAV } from '../lib/site.config';
---

<header class="sticky top-0 z-40 border-b border-[var(--color-border)] bg-[var(--color-paper)]/90 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-5">
    <a href="/" class="text-lg font-bold tracking-tight text-[var(--color-ink)]">
      {SITE.title}
    </a>
    <nav class="flex items-center gap-6 text-sm font-medium text-[var(--color-ink-muted)]">
      {NAV.map((item) => (
        <a href={item.href} class="transition-colors hover:text-[var(--color-brand)]">
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
