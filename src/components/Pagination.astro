---
export interface Props {
  currentPage: number;
  lastPage: number;
  basePath: string; // 例: "/blog" または "/blog/category/お金と暮らし"
}

const { currentPage, lastPage, basePath } = Astro.props;
const prevHref = currentPage > 1 ? (currentPage - 1 === 1 ? basePath : `${basePath}/${currentPage - 1}`) : null;
const nextHref = currentPage < lastPage ? `${basePath}/${currentPage + 1}` : null;
---

{lastPage > 1 && (
  <nav class="mt-10 flex items-center justify-between text-[13px]" aria-label="ページ送り">
    {prevHref ? (
      <a href={prevHref} class="rounded-full border border-[var(--color-brand)] px-5 py-2 text-[var(--color-brand)] hover:bg-[var(--color-brand)] hover:text-[var(--color-surface)]">← 新しい記録</a>
    ) : <span></span>}
    <span class="text-[12px] text-[var(--color-ink-muted)]">{currentPage} / {lastPage}</span>
    {nextHref ? (
      <a href={nextHref} class="rounded-full border border-[var(--color-brand)] px-5 py-2 text-[var(--color-brand)] hover:bg-[var(--color-brand)] hover:text-[var(--color-surface)]">前の記録 →</a>
    ) : <span></span>}
  </nav>
)}
