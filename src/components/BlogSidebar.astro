---
// ブログ記事ページ・カテゴリページ・タグページ・ライブラリページで共通の右カラムナビ。
// 「サイト内検索」「カテゴリ」「人気記事」「タグ一覧」の4ブロックを表示する。
import type { Category } from "@/lib/types";
import { toRouteSlug } from "@/lib/routeSlug";

interface Props {
  categories: Category[];
  popularPosts: { slug: string; title: string }[];
  tags: { name: string; count: number }[];
  searchLabel?: string;
}

const { categories, popularPosts, tags, searchLabel = "サイト内検索" } = Astro.props;
---

<aside class="space-y-8">
  <div>
    <h2 class="text-sm font-bold text-ink-950">{searchLabel}</h2>
    <form action="/search" method="get" class="mt-3 flex gap-2">
      <input
        type="text"
        name="q"
        placeholder="例: ROI、GA4、リード獲得"
        class="w-full rounded-full border border-neutral-200 bg-white px-4 py-2 text-sm text-ink-950 placeholder:text-neutral-400"
      />
      <button type="submit" class="shrink-0 rounded-full bg-brand-600 px-4 py-2 text-sm font-bold text-white hover:bg-brand-700">
        検索
      </button>
    </form>
  </div>

  {
    categories.length > 0 && (
      <div>
        <h2 class="text-sm font-bold text-ink-950">カテゴリ</h2>
        <ul class="mt-3 divide-y divide-neutral-100 border-t border-neutral-100">
          {categories.map((category) => (
            <li>
              <a href={`/blog/category/${encodeURIComponent(toRouteSlug(category.name))}`}
                class="flex items-center justify-between py-3 text-sm text-neutral-600 hover:text-brand-700"
              >
                {category.name}
                <span class="text-neutral-300">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    popularPosts.length > 0 && (
      <div>
        <h2 class="text-sm font-bold text-ink-950">人気記事</h2>
        <ol class="mt-3 space-y-3">
          {popularPosts.map((post, i) => (
            <li class="flex gap-3">
              <span class="mt-0.5 shrink-0 text-sm font-bold text-brand-500">{i + 1}</span>
              <a href={`/blog/${post.slug}`} class="text-sm leading-snug text-neutral-700 hover:text-brand-700">
                {post.title}
              </a>
            </li>
          ))}
        </ol>
      </div>
    )
  }

  {
    tags.length > 0 && (
      <div>
        <h2 class="text-sm font-bold text-ink-950">タグ一覧</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a href={`/blog/tag/${encodeURIComponent(toRouteSlug(tag.name))}`}
              class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-600 hover:bg-brand-50 hover:text-brand-700"
            >
              {tag.name}
            </a>
          ))}
        </div>
      </div>
    )
  }
</aside>
