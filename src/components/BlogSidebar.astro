---
// 記事ページの右カラムに表示するサイドバー。
// ・カテゴリ一覧（Notionの「メインタグ」の値を使う）
// ・人気記事一覧（GA4のページビュー数をもとに取得。取れない場合は呼び出し側で最新記事にフォールバック）
// ・タグ一覧（記事に付けられる複数選択の「タグ」の一覧）
import type { Post } from '../lib/notion';

export interface Props {
  categories: string[];
  popularPosts: Post[];
  tags: string[];
}

const { categories, popularPosts, tags } = Astro.props;
---

<aside class="w-full lg:sticky lg:top-8 lg:w-64 lg:shrink-0">
  <div class="mb-10">
    <h2 class="text-lg font-bold text-[var(--color-ink)]">サイト内検索</h2>
    <form action="/search" method="get" class="mt-3 flex gap-2">
      <input
        type="text"
        name="q"
        placeholder="キーワードを入力"
        class="w-full rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-2 text-sm text-[var(--color-ink)] placeholder:text-[var(--color-ink-muted)]"
      />
      <button type="submit" class="shrink-0 rounded-full bg-[var(--color-brand)] px-4 py-2 text-sm font-bold text-white hover:bg-[var(--color-brand-dark)]">
        検索
      </button>
    </form>
  </div>

  {categories.length > 0 && (
    <div class="mb-10">
      <h2 class="text-lg font-bold text-[var(--color-ink)]">カテゴリ</h2>
      <div class="mt-3 border-t border-[var(--color-border)]">
        {categories.map((category) => (
          <a href={`/blog/category/${encodeURIComponent(category)}`} class="flex items-center justify-between border-b border-[var(--color-border)] py-4 text-sm font-medium text-[var(--color-brand)] transition-colors hover:text-[var(--color-brand-dark)]">
            <span>{category}</span>
            <span class="text-[var(--color-ink-muted)]" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  )}

  {popularPosts.length > 0 && (
    <div class="mb-10">
      <h2 class="text-lg font-bold text-[var(--color-ink)]">人気記事</h2>
      <div class="mt-3 border-t border-[var(--color-border)]">
        {popularPosts.map((post, index) => (
          <a href={`/blog/${post.slug}`} class="flex items-start gap-3 border-b border-[var(--color-border)] py-4 transition-colors hover:text-[var(--color-brand)]">
            <span class="text-sm font-bold text-[var(--color-brand)]">{index + 1}</span>
            <span class="line-clamp-3 text-sm font-semibold leading-snug text-[var(--color-ink)]">
              {post.title}
            </span>
          </a>
        ))}
      </div>
    </div>
  )}

  {tags.length > 0 && (
    <div>
      <h2 class="text-lg font-bold text-[var(--color-ink)]">タグ一覧</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <a href={`/blog/tag/${encodeURIComponent(tag)}`} class="rounded-full bg-[var(--color-brand-soft)] px-3 py-1 text-xs font-medium text-[var(--color-brand-dark)] hover:opacity-80">
            {tag}
          </a>
        ))}
      </div>
    </div>
  )}
</aside>
