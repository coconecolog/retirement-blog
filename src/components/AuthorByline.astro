---
interface Props {
  author: {
    slug: string;
    name: string;
    role: string | null;
    image: string | null;
  };
}
const { author } = Astro.props;
---


  href={`/blog/author/${encodeURIComponent(author.slug)}`}
  class="flex items-center gap-2 text-sm font-medium text-[var(--color-ink)] hover:opacity-80"
>
  {author.image ? (
    <img src={author.image} alt={author.name} class="h-8 w-8 rounded-full object-cover" />
  ) : (
    <span
      class="flex h-8 w-8 items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] text-base"
      aria-hidden="true"
    >
      🙂
    </span>
  )}
  <span>{author.name}</span>
  {author.role && (
    <span class="rounded-full border border-[var(--color-border)] px-2 py-0.5 text-xs font-normal text-[var(--color-ink-muted)]">
      {author.role}
    </span>
  )}
</a>
