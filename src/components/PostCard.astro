---
// 記事カード（テーマページ・タグ・執筆者ページの一覧で使う、縦長のカード）
import { formatDateDot, estimateReadMinutes } from '../lib/format';
import { themeColor } from '../lib/site.config';
import type { Post } from '../lib/notion';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const category = post.categories[0] ?? null;
const readMinutes = estimateReadMinutes(post.html);
---

<a
  href={`/blog/${post.slug}`}
  class="group flex flex-col overflow-hidden rounded-[20px] bg-[var(--color-surface)] shadow-[0_10px_30px_0_rgba(72,24,34,0.07)] transition-shadow hover:shadow-[0_14px_36px_0_rgba(72,24,34,0.12)]"
>
  <div class="aspect-[16/9] w-full overflow-hidden" style={`background-color: ${themeColor(category)}`}>
    {post.thumbnail && (
      <img src={post.thumbnail} alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" />
    )}
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p class="font-serif text-[20px] font-semibold leading-[1.7] text-[var(--color-ink)]">{post.title}</p>
    <p class="mt-3 line-clamp-2 text-[13px] leading-[1.9] text-[var(--color-ink-muted)]">{post.description}</p>
    <div class="mt-auto flex items-center justify-between pt-5">
      <span class="text-[11px] text-[var(--color-ink-muted)]">{formatDateDot(post.publishedAt)} · 約{readMinutes}分</span>
      <span class="text-[12px] text-[var(--color-brand)] group-hover:underline">続きを読む →</span>
    </div>
  </div>
</a>
