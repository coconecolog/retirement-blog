---
import type { Post } from "@/lib/types";
import { DEFAULT_OG_IMAGE } from "@/consts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const dateLabel = new Date(post.publishedAt).toLocaleDateString("ja-JP", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
---

<a href={`/blog/${post.slug}`} class="group block overflow-hidden rounded-2xl border border-neutral-100 bg-white transition-shadow hover:shadow-lg">
  <div class="aspect-video w-full overflow-hidden bg-neutral-100">
    <img
      src={post.thumbnail || DEFAULT_OG_IMAGE}
      alt=""
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </div>
  <div class="p-5">
    {
      post.tags.length > 0 && (
        <div class="mb-2 flex flex-wrap gap-1.5">
          {post.tags.slice(0, 3).map((tag) => (
            <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700">{tag}</span>
          ))}
        </div>
      )
    }
    <h3 class="line-clamp-2 text-lg font-bold leading-snug text-ink-950 group-hover:text-brand-700">
      {post.title}
    </h3>
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-neutral-500">{post.description}</p>
    <p class="mt-3 text-xs text-neutral-400">
      <time datetime={post.publishedAt}>{dateLabel}</time>
    </p>
  </div>
</a>
