---
import SEO from "@/components/SEO.astro";
import Analytics from "@/components/Analytics.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { GTM_ID } from "@/consts";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
   jsonLd?: object | object[];
  // true にすると、このページをサイト内検索（Pagefind）の索引対象から除外する。
  // タグ一覧・カテゴリ一覧のように記事本文を含まない一覧ページ向け。
  // 検索エンジン向けのnoindexとは別物（そちらはSEO.astro側でmeta robotsを制御）。
  pagefindIgnore?: boolean;
}

const { title, description, ogImage, noindex, jsonLd, pagefindIgnore } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <SEO title={title} description={description} ogImage={ogImage} noindex={noindex} jsonLd={jsonLd} />
    <Analytics />
  </head>
  <body class="flex min-h-screen flex-col">
    {
      GTM_ID && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }
    <Header />
   <main class="flex-1" data-pagefind-body={pagefindIgnore ? undefined : true} data-pagefind-ignore={pagefindIgnore ? "all" : undefined}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
